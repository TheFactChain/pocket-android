<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android">

    <androidx.preference.PreferenceCategory
        android:title="@string/settings_about">

        <androidx.preference.Preference android:key="pocket_help" android:title="@string/pocket_help" />
        <androidx.preference.Preference android:key="pocket_licenses" android:title="@string/pocket_licenses" />

        <androidx.preference.Preference
            android:title="@string/pocket_attribution"
            android:selectable="false" />

        <androidx.preference.Preference
            android:key="settings_version"
            android:title="@string/settings_version" />

        <androidx.preference.Preference
            android:key="settings_source_code"
            android:title="@string/pocket_upstream_source"
            android:summary="@string/settings_source_code_url" />

    </androidx.preference.PreferenceCategory>

</androidx.preference.PreferenceScreen>

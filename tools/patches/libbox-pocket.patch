+// realityKeyShares reports whether the hello offers X25519MLKEM768 before a plain X25519 share.
+func realityKeyShares(spec *utls.ClientHelloSpec) bool {
+	for _, extension := range spec.Extensions {
+		if ks, ok := extension.(*utls.KeyShareExtension); ok {
+			hybrid := slices.IndexFunc(ks.KeyShares, func(share utls.KeyShare) bool { return share.Group == utls.X25519MLKEM768 })
+			classic := slices.IndexFunc(ks.KeyShares, func(share utls.KeyShare) bool { return share.Group == utls.X25519 })
+			return hybrid >= 0 && classic > hybrid
+		}
+	}
+	return false
+}

<?xml version="1.0" encoding="utf-8"?>
<!-- The only screen: header, two small cards (proxy, updates), the wide shop card in the middle
     and the apps card that fills the rest. Only the icon grid scrolls if there are many copies. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/ink">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_pocket"
                app:tint="@android:color/white" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:accessibilityHeading="true"
            android:letterSpacing="-0.01"
            android:maxLines="1"
            android:text="Pocket Android"
            android:textColor="@color/ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/home_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/group"
            android:contentDescription="Настройки"
            android:foreground="?android:attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_gear"
                app:tint="@color/ink" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minHeight="136dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/card_proxy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/CardLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Прокси" />

            <TextView
                android:id="@+id/proxy_value"
                style="@style/CardValue"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="4dp"
                android:autoSizeMaxTextSize="26sp"
                android:autoSizeMinTextSize="16sp"
                android:autoSizeTextType="uniform"
                android:gravity="center_vertical"
                android:maxLines="1" />

            <TextView
                android:id="@+id/proxy_detail"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/card_ink_soft"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/proxy_action"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_pill_accent"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@android:color/white"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/proxy_icon"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/ink"
                    android:importantForAccessibility="no"
                    android:padding="8dp"
                    android:src="@drawable/ic_globe"
                    app:tint="@android:color/white" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_updates"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/CardLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Обновления" />

            <TextView
                android:id="@+id/updates_value"
                style="@style/CardValue"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="4dp"
                android:autoSizeMaxTextSize="26sp"
                android:autoSizeMinTextSize="16sp"
                android:autoSizeTextType="uniform"
                android:gravity="center_vertical"
                android:maxLines="1" />

            <TextView
                android:id="@+id/updates_detail"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/card_ink_soft"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/updates_icon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/ink"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:src="@drawable/ic_download"
                app:tint="@android:color/white" />
        </LinearLayout>
    </LinearLayout>

    <!-- Shop: a sunny gradient card with a big tilted bag behind the text and one chip per kind of goods -->
    <FrameLayout
        android:id="@+id/card_shop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:clipChildren="true"
        android:contentDescription="Магазин">

        <ImageView
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="-26dp"
            android:layout_marginBottom="-34dp"
            android:alpha="0.12"
            android:importantForAccessibility="no"
            android:rotation="-16"
            android:src="@drawable/ic_bag"
            app:tint="@color/ink" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                style="@style/CardLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Магазин" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:letterSpacing="-0.02"
                android:maxLines="2"
                android:text="Свой прокси и подписки"
                android:textColor="@color/ink"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- One chip per kind of goods in the catalog, filled in code -->
            <LinearLayout
                android:id="@+id/shop_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="horizontal" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/card_apps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card"
        android:elevation="1dp"
        android:orientation="vertical"
        android:paddingTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="Приложения"
                    android:textColor="@color/ink"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/apps_count"
                    style="@style/Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <ImageView
                android:id="@+id/apps_add"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/ink"
                android:contentDescription="Добавить приложение"
                android:padding="12dp"
                android:src="@drawable/ic_add"
                app:tint="@android:color/white" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fadingEdgeLength="24dp"
            android:requiresFadingEdge="vertical">

            <LinearLayout
                android:id="@+id/apps_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingTop="10dp"
                android:paddingEnd="8dp" />
        </ScrollView>

        <TextView
            android:id="@+id/apps_note"
            style="@style/Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingTop="6dp"
            android:paddingEnd="18dp"
            android:paddingBottom="14dp" />
    </LinearLayout>
</LinearLayout>
